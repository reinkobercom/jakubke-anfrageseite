---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { site } from '../data/site';
import { activeAnnouncements } from '../data/announcements';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ogFallback from '../assets/images/begleitung-senioren.jpg';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  /** Seiten bleiben wie bei Onepage auf noindex (reine Anzeigen-Landingpages) */
  noindex?: boolean;
}

const { title, description, ogImage = ogFallback, noindex = true } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, ''), site.url).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, site.url).href;
const notes = activeAnnouncements(Astro.url.pathname);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'MedicalBusiness'],
  name: site.name,
  url: site.mainWebsite,
  telephone: site.phone.e164,
  email: site.email,
  foundingDate: String(site.foundedYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: 'DE',
  },
  openingHoursSpecification: site.openingHoursSpec.map((o) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: o.days,
    opens: o.opens,
    closes: o.closes,
  })),
  areaServed: ['Werne', 'Selm', 'Lünen', 'Bergkamen', 'Kamen', 'Ascheberg', 'Nordkirchen'],
  sameAs: site.social.map((s) => s.href),
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#003595" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="anfrage.ihr-pflegestuetzpunkt.de" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    {notes.map((n) => (
      <div style="background:#FFDD00;color:#003595;font:600 15px/1.4 var(--font-kit-text-font);text-align:center;padding:10px 16px">
        {n.href ? <a href={n.href} style="color:inherit;text-decoration:underline">{n.text}</a> : n.text}
      </div>
    ))}
    <main id="inhalt">
      <slot />
    </main>
    <slot name="after" />
    <Analytics />

    <script>
      // Einblenden beim Scrollen (ersetzt framer-motion „whileInView“)
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        els.forEach((el) => {
          // Anteil, der sichtbar sein muss – wie „viewport.amount“ im Original.
          // Bei sehr hohen Elementen (größer als der Bildschirm) genügt der sichtbare Anteil.
          const amount = Number(el.dataset.reveal || 0.3);
          const fit = Math.min(amount, (window.innerHeight * 0.9) / Math.max(el.offsetHeight, 1));
          const o = new IntersectionObserver(
            (entries, obs) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  el.classList.add('is-in');
                  obs.disconnect();
                }
              }
            },
            { threshold: Math.max(0.01, fit) },
          );
          o.observe(el);
        });
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }

      // „Jahre in Werne“ immer aktuell halten (Gründungsjahr 1998)
      document.querySelectorAll<HTMLElement>('[data-years-since]').forEach((el) => {
        const y = new Date().getFullYear() - Number(el.dataset.yearsSince);
        if (y > 0) el.textContent = String(y);
      });
    </script>
  </body>
</html>
