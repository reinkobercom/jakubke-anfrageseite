---
// Auswahl-Kachel. Ohne Framework: Zustand über aria-pressed, gesteuert vom Formular-Script.
import styles from '../../styles/ui/option-tile.module.css';
interface Props { label: string; multiple?: boolean; name?: string; value?: string; selected?: boolean; [key: string]: any }
const { label, multiple = false, name, value = label, selected = false, ...rest } = Astro.props;
---
<button type="button" class={styles.tile} data-option data-name={name} data-value={value} data-multiple={multiple ? '' : undefined} data-selected-class={styles.selected} aria-pressed={selected ? 'true' : 'false'} {...rest}>
  <span class={styles.label}>{label}</span>
  <span class:list={[styles.mark, multiple && styles.markSquare]}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 12.5 9 17.5 20 6.5" /></svg>
  </span>
</button>
