---
// Responsives Bild: WebP in mehreren Breiten, feste Maße (kein Layout-Springen).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; class?: string; sizes: string; widths?: number[]; eager?: boolean }
const { src, alt, class: className, sizes, widths = [400, 700, 1000, 1400, 2000], eager = false } = Astro.props;
const w = widths.filter((x) => x <= src.width);
---
<Image src={src} alt={alt} class={className} widths={w.length ? w : [src.width]} sizes={sizes} format="webp" quality={80} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
