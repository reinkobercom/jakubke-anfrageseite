---
import styles from '../../styles/sections/menschen.module.css';
import SectionHeading from '../ui/SectionHeading.astro';
import Title from '../ui/Title.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import { reveal } from '../../lib/reveal';
import { menschen as defaults } from '../../content/haushaltshilfe';
// Inhalt kommt standardmäßig von der Haushaltshilfe-Seite, andere Seiten übergeben ihren eigenen
const { c = defaults } = Astro.props as { c?: any };
---
<section class={styles.section} style={{ backgroundColor: c.bgColor }}>
  <span class={styles.glow} aria-hidden="true" />
  <div class={styles.container}>
    <div class={styles.mosaic} {...reveal({ y: 0, scale: 0.97, dur: 0.6, amount: 0.25 })}>
      <div class={styles.mosaicMain}><Photo class={styles.photo} src={c.imageMain} alt={c.imageMainAlt} sizes="(max-width: 1000px) 100vw, 640px" /></div>
      <div class={styles.mosaicSmall}><Photo class={styles.photo} src={c.imageSecond} alt={c.imageSecondAlt} sizes="(max-width: 1000px) 50vw, 320px" widths={[400, 700, 1000]} /></div>
      <div class={styles.mosaicSmall}><Photo class={styles.photo} src={c.imageThird} alt={c.imageThirdAlt} sizes="(max-width: 1000px) 50vw, 320px" widths={[400, 700, 1000]} /></div>
    </div>
    <div class={styles.right} {...reveal({ y: 24, dur: 0.55, delay: 0.1, amount: 0.25 })}>
      <SectionHeading kicker={c.kicker} align="left" onDark>
        <Title as="h2" size="lg" color="var(--color-kit-white)">{c.headline}</Title>
      </SectionHeading>
      <div class={styles.quoteBox}>
        <p class={styles.quoteText}>{c.quote}</p>
        <div class={styles.quoteAuthor}>
          {c.quoteImage && <Photo class={styles.quoteAvatar} src={c.quoteImage} alt={c.quoteName} sizes="64px" widths={[128, 192]} />}
          <span class={styles.quoteMeta}>
            <span class={styles.quoteName}>{c.quoteName}</span>
            <span class={styles.quoteRole}>{c.quoteRole}</span>
          </span>
        </div>
      </div>
      <ul class={styles.points}>
        {c.points.map((p: any) => (
          <li class={styles.point}><span class={styles.pointIcon}><Icon name="check" size={19} strokeWidth={2.6} /></span>{p.text}</li>
        ))}
      </ul>
      <div class={styles.actions}>
        <Button href={c.ctaHref} variant="accent" size="lg">{c.ctaLabel}<Icon slot="iconRight" name="arrow-right" size={18} /></Button>
        <a class={styles.phone} href={c.phoneHref}><Icon name="phone" size={18} />{c.phoneLabel}</a>
      </div>
    </div>
  </div>
</section>
